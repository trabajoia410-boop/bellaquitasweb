{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "bellaquitas-api-preproduccion",
  "main": "./bellaquitas-api-staging.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bellaquitas-produccion-preparada-20261116",
      "database_id": "3d65c23d-4d03-4988-9d7f-23d4f95cbc3c"
    }
  ],
  "services": [
    {
      "binding": "VIDEO_QA_PROXY",
      "service": "bellaquitas-media-qa",
      "environment": "production"
    }
  ],
  "vars": {
    "STAGING_MUTATIONS": "disabled",
    "ALLOW_NEW_ACCOUNTS": "no",
    "EMAIL_REGISTRATION_ENABLED": "no",
    "EMAIL_AUTH_ENABLED": "no",
    "ADMIN_EMAIL_LINK_ENABLED": "no",
    "SUGGESTIONS_ENABLED": "no",
    "SITE_MODE": "preproduction",
    "PUBLISH_APPROVED": "no"
  },
  "assets": {
    "directory": "./dist-static",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
