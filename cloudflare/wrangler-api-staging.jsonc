{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "bellaquitas-api-staging",
  "main": "./bellaquitas-api-staging.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bellaquitas-staging",
      "database_id": "c7ada9c9-d397-4e22-b5b8-3fbd8d13e550"
    }
  ],
  "services": [
    {
      "binding": "VIDEO_QA_PROXY",
      "service": "bellaquitas-media-qa",
      "environment": "production"
    }
  ],
  "vars": {
    "ADMIN_EMAIL_LINK_ENABLED": "yes"
  },
  "assets": {
    "directory": "./dist-static",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
