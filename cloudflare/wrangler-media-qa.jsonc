{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "bellaquitas-media-qa",
  "main": "./media-qa-worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "cache": {
    "enabled": true
  }
}
